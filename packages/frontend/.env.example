# =============================================================================
# Frontend — @erp/frontend
#
# En desarrollo: copiar a `.env`.
# En producción: cargar esta variable en VERCEL, no en Railway.
#   Las del backend van en Railway. Confundir los dos lugares es el error
#   más común de esta configuración.
#
# Vite inlinea las VITE_* en el bundle en tiempo de build: son públicas.
# Nunca poner un secreto acá.
# =============================================================================

# URL del backend. Nunca hardcodear la API en el código.
# En producción es la URL del servicio de Railway.
VITE_API_URL=http://localhost:3001
