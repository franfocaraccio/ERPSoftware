    "express": "^5.3.0",
    "fast-xml-parser": "^5.12.1",
    "fflate": "^0.8.3",
    "multer": "^2.5.0",
    "pdfkit": "0.20.2",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
