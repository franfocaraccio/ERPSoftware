# =============================================================================
# Backend — @erp/backend
#
# En desarrollo: copiar a `.env` (src/env.ts lo carga con process.loadEnvFile).
# En producción: cargar estas variables en RAILWAY, no en Vercel.
#   Las del frontend van en Vercel. Confundir los dos lugares es el error
#   más común de esta configuración.
# =============================================================================

# --- Base de datos -----------------------------------------------------------

# Conexión de la APLICACIÓN — rol sin BYPASSRLS, en session mode (no transaction
# pooling). La numeración de comprobantes usa pg_advisory_xact_lock y requiere
# session mode: con transaction pooling se rompe.
DATABASE_URL=postgresql://erp_app:erp_app@localhost:5432/erp

# Conexión para MIGRACIONES — rol owner del schema. La usan drizzle-kit y el
# seed. En producción NO se carga en Railway: las migraciones se aplican a mano
# desde la máquina del desarrollador.
DATABASE_URL_MIGRATIONS=postgresql://erp:erp@localhost:5432/erp

# --- Servidor ----------------------------------------------------------------

# Puerto de escucha. En Railway lo inyecta la plataforma, no hace falta setearlo.
PORT=3001

# Origen del frontend. Gobierna CORS, los trustedOrigins de BetterAuth y los
# links de los mails transaccionales. En producción es la URL de Vercel.
FRONTEND_URL=http://localhost:5173

# --- Autenticación (BetterAuth) ----------------------------------------------

# OBLIGATORIA: el backend no arranca sin esto (auth/auth.ts:12).
# Generar una distinta por entorno con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL pública del propio backend. En producción es la URL de Railway.
BETTER_AUTH_URL=http://localhost:3001

# --- Mails transaccionales (Resend) ------------------------------------------

# Sin API key los mails no se envían: se loguea el link a la consola. Alcanza
# para desarrollo, pero en producción es obligatoria — sin ella nadie puede
# aceptar una invitación ni recuperar su contraseña.
RESEND_API_KEY=
RESEND_FROM=ERP PyME <onboarding@resend.dev>

# --- Seed de desarrollo ------------------------------------------------------
# Sólo las usa `pnpm db:seed`. Tienen defaults; no cargarlas en producción.

SEED_ADMIN_EMAIL=admin@erppyme.dev
SEED_ADMIN_PASSWORD=admin-plataforma-2026
SEED_DUENO_EMAIL=dueno@demo.dev
SEED_DUENO_PASSWORD=dueno-demo-2026
